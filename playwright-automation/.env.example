# Copy this file to .env and fill in values needed for your local run.
MAHO_BASE_URL=https://maho-26.9.3.ddev.site
MAHO_ADMIN_PATH=/admin

# Product fixture (defaults match the local demo catalog)
PW_PRODUCT_URL=/default/building-blocks-50-pieces/
PW_PRODUCT_NAME=Building blocks, 50 pieces
PW_PRODUCT_PRICE=45
PW_CATEGORY_URL=/default/kids/
PW_REDIRECT_TO_CART=false
PW_CONTINUE_SHOPPING_URL=/default/

# Shipping and payment labels (must match enabled local methods)
PW_SHIPPING_LABEL=Flat Rate
PW_SHIPPING_PRICE=5
PW_PAYMENT_LABEL=Check / Money order

# Optional registered customer scenarios (18–20 and 25)
PW_CUSTOMER_EMAIL=
PW_CUSTOMER_PASSWORD=
PW_REGISTERED_ORDER_ID=

# Optional admin scenarios (21–24)
MAHO_ADMIN_USERNAME=
MAHO_ADMIN_PASSWORD=
PW_ADMIN_ORDER_ID=
PW_ADMIN_ORDER_ENTITY_ID=
PW_CANCEL_ORDER_ENTITY_ID=

# Product Management Playwright suite
# Required to enable admin product/category scenarios
PW_PM_IMAGE_PATH=
# Optional storefront fixtures; scenarios skip with a reason when unset
PW_PM_CATEGORY_URL=
PW_PM_HOME_URL=/
PW_PM_STOREFRONT_PRODUCT_NAME=
PW_PM_STOREFRONT_PRODUCT_SKU=
PW_PM_PRODUCT_URL=
PW_PM_PRODUCT_PRICE=50
PW_PM_STORE_TIMEZONE=UTC
PW_PM_CONFIGURABLE_ATTRIBUTE=
PW_PM_CONFIGURABLE_SKU=
PW_PM_VARIANT_SKU=
PW_PM_CONFIGURABLE_PRODUCT_URL=
PW_PM_SWATCH_LABEL=Blue
# Set true only after confirming the local product grid has a price range filter
PW_PM_PRICE_FILTER_AVAILABLE=false

# Promotion Management Playwright suite
# Admin grid/form cases need the admin credentials above. Storefront cases use
# the local simple product unless a case lists a dedicated fixture below.
PW_PROMO_WEBSITE=Main Website
PW_PROMO_CUSTOMER_GROUP=NOT LOGGED IN
PW_PROMO_PRODUCT_URL=/default/building-blocks-50-pieces/
PW_PROMO_PRODUCT_PRICE=45
PW_PROMO_DATE_FORMAT=en-US
# Isolated simple products with no overlapping catalog rules
PW_PROMO_FUTURE_PRODUCT_URL=
PW_PROMO_FUTURE_PRODUCT_PRICE=
PW_PROMO_CALC_PRODUCT_URL=
PW_PROMO_CALC_PRODUCT_PRICE=
PW_PROMO_PRIORITY_PRODUCT_URL=
PW_PROMO_PRIORITY_PRODUCT_PRICE=
PW_PROMO_APPLY_PRODUCT_URL=
PW_PROMO_APPLY_PRODUCT_PRICE=
# Preconfigured rules and fixture products for advanced cart conditions
PW_PROMO_SUBTOTAL_COUPON=
PW_PROMO_SUBTOTAL_PRODUCT_99_URL=
PW_PROMO_SUBTOTAL_PRODUCT_100_URL=
PW_PROMO_SUBTOTAL_PRODUCT_101_URL=
PW_PROMO_CATEGORY_PRODUCT_URL=
PW_PROMO_NON_CATEGORY_PRODUCT_URL=
PW_PROMO_CATEGORY_COUPON=
PW_PROMO_QUANTITY_COUPON=
PW_PROMO_RULES_PRODUCT_URL=
PW_PROMO_RULES_PRODUCT_PRICE=
PW_PROMO_FREE_SHIPPING_COUPON=
PW_PROMO_CUSTOMER_LIMIT_COUPON=
PW_PROMO_GLOBAL_LIMIT_COUPON=
PW_PROMO_CUSTOMER2_EMAIL=
PW_PROMO_CUSTOMER2_PASSWORD=
